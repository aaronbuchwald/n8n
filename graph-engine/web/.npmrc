# This web app is a self-contained pnpm workspace with a committed lockfile.
#
# Newer pnpm treats an un-approved dependency build script as a HARD error, and
# `pnpm build`/`pnpm dev` run an implicit pre-run "deps status check" install
# that then exits non-zero. esbuild's build script is safe to skip (it ships its
# platform binary as a package), so we disable that pre-run install here — the
# scripts run directly. `esbuild` is also allow-listed in package.json +
# pnpm-workspace.yaml so an explicit `pnpm install` builds it without complaint.
verify-deps-before-run=false
