{
  "name": "graph-engine-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only ReactFlow renderer for the graph-engine example graph. Self-contained; all assets bundled locally (no CDN).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "test": "playwright test",
    "test:server-mount": "playwright test --config=playwright.server-mount.config.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
